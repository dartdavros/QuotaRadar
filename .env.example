# QuotaRadar bootstrap configuration. Copy to .env and replace every placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
QUOTARADAR_WEB_BIND_ADDRESS=0.0.0.0
POSTGRES_DB=quotaradar
POSTGRES_USER=quotaradar
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Первичное наполнение новостного канала: платное чтение истории X и отправка в реальный канал.
# Включать только на рабочем сервере и только на время запуска, затем вернуть false.
QUOTARADAR_NEWS_INITIAL_FILL_ALLOWED=false
